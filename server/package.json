{
  "name": "resumeos-server",
  "version": "1.0.0",
  "description": "ResumeOS API: resume CRUD and PDF export",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec \"tsx src/index.ts\"",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "mongoose": "^9.11.3",
    "puppeteer": "^25.16.0",
    "tsx": "^4.20.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.5",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9"
  }
}
