# Server port
PORT=5000

# The frontend's URL, for CORS. Must be the real deployed URL in production.
CLIENT_URL=http://localhost:5173

# MongoDB connection string (MongoDB Atlas or local).
MONGODB_URI=

# Optional. Resumes one IP address may create per hour (default 60). Raise it
# only for load tests; it is what stops one machine filling the database.
# CREATE_LIMIT_PER_HOUR=60
